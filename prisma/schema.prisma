generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.0.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String
  role      String     @default("admin")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]
}

model Service {
  id           Int         @id @default(autoincrement())
  slug         String      @unique
  name         String
  number       String
  shortDesc    String      @db.Text
  description  String      @db.Text
  whatWeBuild  String      @db.Text
  approach     String      @db.Text
  technologies String      @db.Text
  benefits     String      @db.Text
  features     String      @db.Text
  icon         String      @default("spark")
  image        String?
  category     String      @default("Web")
  status       String      @default("active")
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  portfolios   Portfolio[]
}

model Portfolio {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  name         String
  client       String
  industry     String
  category     String
  shortDesc    String            @db.Text
  overview     String            @db.Text
  challenge    String            @db.Text
  solution     String            @db.Text
  design       String            @db.Text
  technology   String            @db.Text
  features     String            @db.Text
  results      String            @db.Text
  technologies String            @db.Text
  services     String            @db.Text
  projectUrl   String?
  image        String
  featured     Boolean           @default(false)
  status       String            @default("published")
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  images       PortfolioImage[]
  serviceId    Int?
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId])
}

model PortfolioImage {
  id          Int       @id @default(autoincrement())
  url         String
  alt         String
  sortOrder   Int       @default(0)
  portfolioId Int
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String
  url       String?
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  position  String
  bio       String   @db.Text
  photo     String
  skills    String   @db.Text
  linkedin  String?
  twitter   String?
  github    String?
  dribbble  String?
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  position  String
  company   String
  photo     String
  quote     String   @db.Text
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogCategory {
  id    Int        @id @default(autoincrement())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogTag {
  id    Int           @id @default(autoincrement())
  name  String
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  title           String
  seoTitle        String?
  metaDescription String        @db.Text
  excerpt         String        @db.Text
  content         String        @db.LongText
  featuredImage   String
  published       Boolean       @default(false)
  featured        Boolean       @default(false)
  popular         Boolean       @default(false)
  publishedAt     DateTime?
  readingTime     Int           @default(5)
  views           Int           @default(0)
  authorId        Int
  author          User          @relation(fields: [authorId], references: [id])
  categoryId      Int
  category        BlogCategory  @relation(fields: [categoryId], references: [id])
  tags            BlogPostTag[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([authorId])
  @@index([categoryId])
}

model BlogPostTag {
  postId Int
  tagId  Int
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Statistic {
  id        Int    @id @default(autoincrement())
  key       String @unique
  label     String
  value     Int
  suffix    String @default("+")
  sortOrder Int    @default(0)
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

model SocialLink {
  id        Int    @id @default(autoincrement())
  platform  String
  url       String
  sortOrder Int    @default(0)
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Technology {
  id        Int    @id @default(autoincrement())
  name      String
  category  String
  icon      String?
  sortOrder Int    @default(0)
  status    String @default("active")
}

model ProcessStep {
  id          Int    @id @default(autoincrement())
  number      String
  title       String
  description String @db.Text
  sortOrder   Int    @default(0)
}
